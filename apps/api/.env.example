# Base de données de synchronisation
DATABASE_URL="postgresql://workpulse:workpulse@localhost:5432/workpulse?schema=public"

# Port d'écoute de l'API
PORT=3000

# Origines autorisées, séparées par des virgules. Vide = CORS désactivé.
CORS_ORIGINS="http://localhost:5173"

# Appels par minute et par IP
RATE_LIMIT_PER_MINUTE=120

# Exposer /docs (Swagger). À passer à false en production publique.
SWAGGER_ENABLED=true
