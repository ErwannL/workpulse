{
  "name": "workpulse",
  "private": true,
  "version": "0.5.1",
  "description": "Assistant personnel de temps de travail — monorepo",
  "license": "MIT",
  "author": "Erwann Laplante",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErwannL/workpulse.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build --workspace @workpulse/web && npm run build --workspace @workpulse/api",
    "dev": "npm run dev --workspace @workpulse/web",
    "dev:api": "npm run dev --workspace @workpulse/api",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @workpulse/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "npm run build:core && npm run typecheck --workspaces --if-present",
    "verify": "npm run changelog:check && npm run check:migrations && npm run format && npm run lint && npm run typecheck && npm run test:cov",
    "graph": "graphify update . && graphify export callflow-html",
    "build:core": "npm run build --workspace @workpulse/core",
    "changelog": "node scripts/build-changelog.mjs",
    "changelog:check": "node scripts/build-changelog.mjs --check",
    "android": "npm run build --workspace @workpulse/web && npm run android:sync --workspace @workpulse/web",
    "test:perf": "npm run test:perf --workspace @workpulse/core",
    "test:load": "npm run test:load --workspace @workpulse/api",
    "check:migrations": "node scripts/check-migrations.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.2.7"
  }
}
